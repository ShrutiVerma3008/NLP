# ─────────────────────────────────────────────────────────────────────────────
# AI Resume Intelligence System — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# OpenRouter API key — get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── REQUIRED for CORS (production) ───────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# For local dev both localhost variants are needed because browsers differ.
# In production, set this to your deployed Vercel URL (no trailing slash).
#   Example: ALLOWED_ORIGINS=https://ai-ris.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# GitHub personal access token (classic or fine-grained, read-only scope).
# Without this, the GitHub API is unauthenticated: 60 requests/hour per IP.
# With this token it raises to 5,000 requests/hour.
#   Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=