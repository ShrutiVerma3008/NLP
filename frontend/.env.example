# ─────────────────────────────────────────────────────────────────────────────
# AI Resume Intelligence System — Frontend Environment Variables
# Copy this file to .env or .env.local and fill in values.
# ─────────────────────────────────────────────────────────────────────────────

# API Base URL for backend endpoint calls.
# In local development, leave blank to use Vite dev proxy (http://localhost:8000).
# In production (e.g. Vercel deployment), set this to your backend service URL.
#   Example: VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=http://localhost:8000
